#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sysop Network"
            VALUE "FileDescription", "BloX - ANSI falling-block puzzle game for The Major BBS v10"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "SNBLOX"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sysop Network"
            VALUE "OriginalFilename", "SNBLOX.DLL"
            VALUE "ProductName", "BloX"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
